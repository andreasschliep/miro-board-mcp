{
  "name": "miro-board-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets an agent validate, preview and build Miro boards from a YAML description.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Andreas Schliep",
  "bin": {
    "miro-board-mcp": "dist/server.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist",
    "examples",
    "resources"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "start": "node dist/server.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/server.js"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.3",
    "@mermaid-js/parser": "2.0.1",
    "@modelcontextprotocol/server": "2.4.0",
    "js-yaml": "5.5.0",
    "jsdom": "30.1.3",
    "marked": "18.1.2",
    "mermaid": "12.2.0",
    "miro-board-builder": "file:vendor/miro-board-builder",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/jsdom": "21.1.7",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "prettier": "^3.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
