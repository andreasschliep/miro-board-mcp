# Miro access token with boards:read and boards:write.
# Needed for build_board (also its dry run) and list_frames. Never commit a real token.
MIRO_ACCESS_TOKEN=replace-me

# Optional: team for new boards.
MIRO_TEAM_ID=

# Optional: comma-separated ids of existing boards the server may read and write.
# Boards the server creates itself are always allowed for the rest of the process.
MIRO_MCP_ALLOWED_BOARD_IDS=

# Optional: comma-separated hosts allowed for image and embed URLs (none by default).
MIRO_MCP_ALLOWED_URL_HOSTS=
